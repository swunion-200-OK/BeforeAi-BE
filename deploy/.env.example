# EC2 서버의 /home/ubuntu/app/.env 로 복사해 실제 값을 채운다.
# systemd(beforeai.service)의 EnvironmentFile이 이 파일을 읽는다.
# 절대 git에 커밋하지 않는다. (권한 600 권장: chmod 600 .env)

# 운영 프로파일
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL (Supabase). 반드시 JDBC URL 형식이어야 한다.
# 형식: jdbc:postgresql://<HOST>:5432/postgres
DB_URL=jdbc:postgresql://db.xxxxxxxx.supabase.co:5432/postgres
DB_USERNAME=app_user
DB_PASSWORD=change-me

# JWT 서명 키 (32바이트 이상)
JWT_SECRET=change-me-to-a-random-32byte-or-longer-secret

# HTTPS 뒤에 있으면 true 유지. HTTP로만 접근하면 false
AUTH_REFRESH_COOKIE_SECURE=true

# 브라우저에서 허용할 프론트 출처 (쉼표 구분, 패턴 가능)
CORS_ALLOWED_ORIGINS=https://swunion.pages.dev,https://*.swunion.pages.dev

# 내부망으로 볼 출발지 IP 대역 (쉼표 구분). 기본값은 Tailscale 대역
INTERNAL_CIDRS=100.64.0.0/10

# 웹쉘 공개키 핀 (Base64, raw 32바이트). 웹쉘 시스템 전체의 단일 신원 키다.
# 승인자 서명 키(signing_keys)와는 다르다 — 그쪽은 .env 가 아니라 API 로 등록한다.
# (운영 규칙: .docs/signing-key-admin-proof.md)
# 웹쉘 crypto 가 준비되기 전에는 비워둬도 된다(그 API만 502, 기동·배포에 영향 없음).
WEBSHELL_ENCRYPTION_PUBLIC_KEY=
WEBSHELL_SIGNING_PUBLIC_KEY=

# 내부망 웹쉘 연동 (실행 중단 kill API). 둘 다 비면 웹쉘 호출만 502, 앱 기동·다른 API에는 영향 없음.
# WEBSHELL_BASE_URL: 내부망 웹쉘 주소 (예: https://webshell.internal:8443)
# WEBSHELL_SSL_BUNDLE: mTLS 클라이언트 인증서 SSL 번들 이름.
#   번들은 application.properties 에 spring.ssl.bundle.pem.<이름>.keystore.* / truststore.* 로 등록.
WEBSHELL_BASE_URL=
WEBSHELL_SSL_BUNDLE=
